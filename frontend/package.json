    "@babel/preset-typescript": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.4",
    "@playwright/test": "1.58",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "postcss": "8.5.29",
